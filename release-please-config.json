{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "0.1.0",
      "version-file": "VERSION",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='proto')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='agent-core')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='guest-agent')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='qafas')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='qafas-sandbox')].version" },
        { "type": "toml", "path": "sdk/python/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "json", "path": "sdk/ts/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "sdk/ts/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "sdk/ts/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "generic", "path": "crates/proto/src/lib.rs" },
        { "type": "generic", "path": "controlplane/internal/events/types.go" },
        { "type": "generic", "path": "sdk/ts/src/types.ts" },
        { "type": "generic", "path": "deploy/docker/.env.example" },
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "docs/deployment.md" },
        { "type": "generic", "path": "docs/airgap.md" },
        { "type": "generic", "path": "sdk/go/version.go" },
        { "type": "generic", "path": "sdk/go/README.md" },
        { "type": "generic", "path": "sdk/rust/README.md" },
        { "type": "generic", "path": "sdk/java/pom.xml" },
        { "type": "generic", "path": "sdk/java/src/main/java/io/github/exitcodenihil/qafas/Qafas.java" }
      ]
    }
  }
}
