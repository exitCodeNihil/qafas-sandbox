# Control plane URL for service discovery (e.g., http://host.docker.internal:7800)
# On Linux, use the actual IP or hostname instead of host.docker.internal
SBX_CP_URL=http://host.docker.internal:7800

# Bearer token for accessing control plane metrics endpoint
# Should match SBX_HOST_TOKEN or SBX_ADMIN_TOKEN on the control plane
SBX_METRICS_TOKEN=your-token-here

# Grafana admin password (default: admin)
GF_SECURITY_ADMIN_PASSWORD=admin
