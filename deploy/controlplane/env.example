# /etc/controlplane/env — read by controlplane.service. Restart after editing.
# The package replaces every CHANGE_ME with a random value on first install.

SBX_LISTEN=:7800

# Signs you into the dashboard and the CLI (export it as SBX_ADMIN_TOKEN there).
SBX_ADMIN_TOKEN=CHANGE_ME
# Lets workers register: the same value is each worker's host_token.
SBX_HOST_TOKEN=CHANGE_ME
# Mints scoped sandbox tokens: the same value is each worker's token.
SBX_TOKEN_SECRET=CHANGE_ME

SBX_DB=/var/lib/controlplane/sandbox.db
SBX_RETENTION_DAYS=30

# Push session traces to an OTLP/HTTP receiver (Jaeger, Langfuse, …). Empty: off.
# SBX_OTLP_URL=http://127.0.0.1:4318/v1/traces
# SBX_OTLP_HEADERS=Authorization=Bearer …

# Verify workers' TLS certificates against this CA instead of pinning the
# fingerprint each one registered with.
# SBX_CA_FILE=/etc/controlplane/ca.crt

# Serve HTTPS (the dashboard, the API, worker registration) with this PEM pair — both or
# neither. Readable by the controlplane group: chgrp controlplane …; chmod 0640 ….
# Workers then use an https cp_url and trust the issuing CA (their ca_file).
# SBX_TLS_CERT=/etc/controlplane/tls.crt
# SBX_TLS_KEY=/etc/controlplane/tls.key
