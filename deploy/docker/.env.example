# Copy to .env next to compose.yml. Mint the three tokens with: openssl rand -hex 24
# x-release-please-start-version
QAFAS_VERSION=0.4.0
# x-release-please-end
SBX_ADMIN_TOKEN=
SBX_HOST_TOKEN=
SBX_TOKEN_SECRET=

# The worker. On one machine the defaults are right.
SBX_HOST_ID=worker-1
# SBX_CP_URL=http://controlplane.example:7800
# SBX_PUBLIC_URL=http://this-worker.example:7700

# The OCI runtime the sandboxes run under; a name registered with the engine (Docker: daemon.json
# "runtimes"), for example runsc for gVisor. Empty = the engine's default (docs/deployment.md 5.1).
# SBX_VM_RUNTIME=

# PEM of an internal CA the egress proxy should trust for route hosts (docs/deployment.md 7). Mount the
# file into the qafas container (compose.yml) and give its path inside the container.
# SBX_EGRESS_CA_FILE=

# podman instead of Docker:
# CONTAINER_SOCK=/run/podman/podman.sock
